# Keep the build context minimal and reproducible.
# The image runs `npm ci` and `vite build`; local installs and build output
# must not be copied in.

# Dependencies and build output (rebuilt inside the image)
node_modules/
dist/
.vite/
coverage/
*.tsbuildinfo

# Local env / logs
.env
.env.*
*.log
npm-debug.log*

# Tooling / editor / OS
.git/
.gitignore
.idea/
.vscode/
.DS_Store

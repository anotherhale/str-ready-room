# Copy to `.env` (or export) to override the dev-server API proxy target.
#
# The Vite dev server forwards /api to a running READY ROOM backend. The default
# is http://localhost:8000, which matches a backend started directly, e.g.:
#
#   cd backend && uvicorn app.main:app --reload --port 8000
#
# If the backend is running inside Docker Compose its port is not published to
# the host; either publish it (add a `ports:` entry) or point this at the nginx
# origin that fronts the whole stack:
#
#   VITE_API_PROXY_TARGET=http://localhost:8080
#
VITE_API_PROXY_TARGET=http://localhost:8000
